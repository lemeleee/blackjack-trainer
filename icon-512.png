*{box-sizing:border-box}body{margin:0;font-family:Arial,sans-serif;background:#101820;color:#eee}.app{max-width:1100px;margin:auto;padding:24px}header{display:flex;justify-content:space-between;align-items:center}.table,aside{border-radius:16px;padding:24px}.table{background:#17402f;min-height:650px}aside{background:#17252d}main{display:grid;grid-template-columns:1fr 300px;gap:20px}h1{margin:0 0 20px}.cards{display:flex;justify-content:center;gap:10px;min-height:90px}.card{width:62px;height:86px;background:#fff;color:#111;border-radius:8px;display:flex;align-items:center;justify-content:center;font-size:22px;font-weight:bold}.red{color:#c22}.hand{text-align:center;padding:15px;margin:15px auto;background:#20523d;border-radius:10px;max-width:550px}.active{outline:2px solid #e5c85b}.actions{display:flex;flex-wrap:wrap;justify-content:center;gap:10px;margin-top:25px}button{padding:12px 18px;border:0;border-radius:8px;background:#e5c85b;font-weight:bold;cursor:pointer}button:disabled{opacity:.35}.message{text-align:center;margin:20px;min-height:25px}@media(max-width:800px){main{grid-template-columns:1fr}}
.decision-row{display:flex;justify-content:space-between;padding:7px 0}
